#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "digest"
require "json"
require "optparse"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "elelem/candle"

options = { tokens: 256, decode: 32, chunk: 128, context: 8192, step: false, profile: false }
OptionParser.new do |o|
  o.banner = "usage: script/bench MODEL [options]"
  o.on("--tokens N", Integer) { options[:tokens] = it }
  o.on("--decode N", Integer) { options[:decode] = it }
  o.on("--chunk N", Integer) { options[:chunk] = it }
  o.on("--context N", Integer) { options[:context] = it }
  o.on("--step") { options[:step] = true }
  o.on("--profile") { options[:profile] = true }
end.parse!
path = ARGV.fetch(0) { abort "usage: script/bench MODEL [options]" }

TOOLS = [
  { type: "function",
    function: { name: "read", description: "Read a file",
                parameters: { type: "object", properties: { path: { type: "string" } }, required: ["path"] } } },
  { type: "function",
    function: { name: "write", description: "Write a file",
                parameters: { type: "object", properties: { path: { type: "string" }, content: { type: "string" } },
                              required: %w[path content] } } },
  { type: "function",
    function: { name: "execute", description: "Run a shell command",
                parameters: { type: "object", properties: { command: { type: "string" } }, required: ["command"] } } }
].freeze

def filler(chars)
  text = File.read(File.expand_path("../README.md", __dir__))
  (text * ((chars / text.size) + 1))[0, chars]
end

def run(model, messages, tools, options)
  prompt = model.render(JSON.generate(messages), JSON.generate(tools), false)
  text = +""
  wall = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  cpu = Process.clock_gettime(Process::CLOCK_PROCESS_CPUTIME_ID)
  first = nil
  stats = model.generate(prompt, options, proc { |piece|
    first ||= Process.clock_gettime(Process::CLOCK_MONOTONIC)
    text << piece
  })
  now = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  stats.merge(
    text:,
    wall: now - wall,
    first: (first || now) - wall,
    cores: (Process.clock_gettime(Process::CLOCK_PROCESS_CPUTIME_ID) - cpu) / (now - wall)
  )
end

def report(label, result)
  prefill = (result[:n_prompt] - result[:n_reused].to_i) / (result[:ms_prefill] / 1000.0)
  decode = result[:n_decoded] / (result[:ms_decode] / 1000.0)
  puts format(
    "%-6s n_prompt=%d n_reused=%d prefill=%.1f tok/s decode=%.1f tok/s first=%.2fs total=%.2fs cores=%.2f sha=%s",
    label, result[:n_prompt], result[:n_reused].to_i, prefill, decode, result[:first], result[:wall],
    result[:cores], Digest::SHA256.hexdigest(result[:text])[0, 12]
  )
  %i[profile_prefill profile_decode].each do |key|
    next unless (sections = result[key])

    total = sections.values.sum
    puts format("  %-8s %s", key.to_s.delete_prefix("profile_"),
                sections.map { |name, ms| format("%s=%.0f%%", name, ms * 100 / total) }.join(" "))
  end
end

started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
model = Elelem::Candle::Model.load(File.expand_path(path), options[:context])
puts format("load   %.2fs %s", Process.clock_gettime(Process::CLOCK_MONOTONIC) - started, File.basename(path))
generate = { max_tokens: options[:decode], temperature: 0.0, top_k: 20, top_p: 0.95, seed: 1, chunk: options[:chunk],
             profile: options[:profile] }

if options[:step]
  system = "You are a coding agent. Use the tools to answer."
  user = "Read README.md and tell me what this gem does in one sentence."
  messages = [{ role: "system", content: system }, { role: "user", content: user }]
  report("turn1", run(model, messages, TOOLS, generate))
  messages += [
    { role: "assistant", content: "",
      tool_calls: [{ id: "call_1", name: "read", arguments: { "path" => "README.md" } }] },
    { role: "tool", tool_call_id: "call_1", content: JSON.generate(content: filler(1200)) }
  ]
  report("turn2", run(model, messages, TOOLS, generate))
else
  messages = [{ role: "user", content: "#{filler((options[:tokens] * 3.5).to_i)}\n\nSummarize the text above." }]
  report("plain", run(model, messages, [], generate))
end
